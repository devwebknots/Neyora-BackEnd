# Copy this file to .env and fill in real values. Never commit the real .env —
# see .gitignore. Every one of these is read via python-decouple's config(),
# never os.environ — see the warning at the top of neyora_backend/settings.py.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the already-provisioned neyora_db/neyora_app role on the shared
# urbannest-neyora-shared EC2 instance (infra side is ready and idle — see
# infrastructure/UrbanNest_AWS_Deployment_Running.md §6). For local dev, point
# these at your own local Postgres instead.
DB_NAME=neyora_db
DB_USER=neyora_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Comma-separated list of origins allowed to embed the widget and call this API
# directly from the browser (ARCH_050). Empty in dev is fine if you're only
# hitting the API server-to-server; add UrbanNest's own frontend origin(s) once
# the widget is actually embedded somewhere.
CORS_ALLOWED_ORIGINS=

# Swap for a real transactional provider's Django email backend in Phase 1E
# (ARCH_053) — console backend just prints emails to stdout.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
